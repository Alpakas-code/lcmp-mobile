# Use Expo Go when testing the app through Expo Go.
MAESTRO_APP_ID=host.exp.exponent

# Use the real package name when testing a development build.
# Example:
# MAESTRO_APP_ID=com.lcmp.mobile

# For Android emulator + development build, open the Expo dev-client Metro URL.
# Keep Metro running with `npm run start -- --dev-client`.
# Use 10.0.2.2 for Android emulator, or your computer LAN IP for a physical device.
MAESTRO_DEV_CLIENT_URL=lcmpmobile://expo-development-client/?url=http%3A%2F%2F10.0.2.2%3A8081
